                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Saldo Inicial]]></text>
            </staticText>
            <staticText>
                <reportElement x="240" y="0" width="65" height="25"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Ingresos]]></text>
