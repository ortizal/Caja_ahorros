    <field name="saldoFinal" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="25"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Caja]]></text>
            </staticText>
            <textField>
