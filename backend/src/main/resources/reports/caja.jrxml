            <staticText>
                <reportElement x="370" y="0" width="70" height="25"/>
                <textElement>
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Saldo Final]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="50" height="25"/>
