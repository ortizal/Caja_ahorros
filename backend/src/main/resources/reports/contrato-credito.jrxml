<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="contrato-credito" pageWidth="612" pageHeight="792"
              columnWidth="555" leftMargin="30" rightMargin="30"
              topMargin="30" bottomMargin="30">

    <parameter name="CUOTAS_DATA" class="net.sf.jasperreports.engine.JRDataSource"/>
    <parameter name="FECHA_GENERACION" class="java.lang.String"/>

    <field name="numeroContrato" class="java.lang.String"/>
    <field name="fechaFirma" class="java.lang.String"/>
    <field name="socioCodigo" class="java.lang.String"/>
    <field name="socioIdentificacion" class="java.lang.String"/>
    <field name="socioNombres" class="java.lang.String"/>
    <field name="socioApellidos" class="java.lang.String"/>
    <field name="socioTelefono" class="java.lang.String"/>
    <field name="socioEmail" class="java.lang.String"/>
    <field name="socioDireccion" class="java.lang.String"/>
    <field name="producto" class="java.lang.String"/>
    <field name="sistemaAmortizacion" class="java.lang.String"/>
    <field name="monto" class="java.lang.String"/>
    <field name="tasaInteres" class="java.lang.String"/>
    <field name="tasaMora" class="java.lang.String"/>
