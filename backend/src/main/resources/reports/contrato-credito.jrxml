                <reportElement x="360" y="97" width="195" height="14"/>
                <textElement><font size="9"/></textElement>
                <textFieldExpression><![CDATA[$F{socioEmail}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="114" width="120" height="14"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Direccion:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="114" width="435" height="14"/>
