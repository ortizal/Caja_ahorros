                    <columnGroup name="column0" width="50">
                        <detail>
                            <staticText>
                                <reportElement x="0" y="0" width="50" height="16"/>
                                <box>
                                    <pen lineWidth="0.5"/>
                                </box>
                                <textElement textAlignment="Center" verticalAlignment="Middle">
                                    <font size="7" isBold="true"/>
