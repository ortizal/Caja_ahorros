    <field name="fechaDesembolso" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[CONTRATO DE CREDITO]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="25" width="555" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[ALANTEK - Caja de Ahorros]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="340" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="120" height="15"/>
                <textElement><font size="9" isBold="true"/></textElement>
                <text><![CDATA[No. Contrato:]]></text>
            </staticText>
            <textField>
                <reportElement x="120" y="0" width="150" height="15"/>
